{
  "expo": {
    "name": "Huddle App",
    "slug": "huddle-app",
    "version": "0.1.0",
    "scheme": "huddle",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Huddle to access your photos.",
          "cameraPermission": "Allow Huddle to access your camera.",
          "microphonePermission": "Allow Huddle to access your microphone for video capture."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:huddle.pet"
      ],
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Allow Huddle to send you updates and alerts."
      },
      "bundleIdentifier": "pet.huddle",
      "appleTeamId": "AN4TY85CTU"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "pet.huddle",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "huddle.pet",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
