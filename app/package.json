{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules",
        "./modules"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:simulator:dev-client": "HUDDLE_IOS_SIMULATOR_DEV=1 HUDDLE_SKIP_NATIVE_FACE_DETECTOR=1 expo run:ios --no-bundler",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && eslint app",
    "postinstall": "node scripts/patch-expo-text-extractor-ios-orientation.js && node scripts/patch-stripe-react-native-ios-interop.js && node scripts/patch-bacons-apple-targets-rich-notification.js && node scripts/patch-expo-notifications-ios-simulator-keychain.js"
  },
