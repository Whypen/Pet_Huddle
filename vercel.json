{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/turnstile-native.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/brandweb/huddle-v5.html" },
    { "src": "^/care/?$", "dest": "/brandweb/care.html" },
    { "src": "^/community/?$", "dest": "/brandweb/community.html" },
    { "src": "^/pricing/?$", "dest": "/brandweb/pricing.html" },
    { "src": "^/live-map/?$", "dest": "/brandweb/live-map.html" },
    { "src": "^/pet-profiles/?$", "dest": "/brandweb/pet-profiles.html" },
    { "src": "^/about/?$", "dest": "/brandweb/about.html" },
    { "src": "^/press/?$", "dest": "/brandweb/press.html" },
    { "src": "^/careers/?$", "dest": "/brandweb/careers.html" },
    { "src": "^/contact/?$", "dest": "/brandweb/contact.html" },
    { "src": "^/faq/?$", "dest": "/brandweb/faq.html" },
    { "src": "^/knowledge-base/?$", "dest": "/brandweb/knowledge-base.html" },
    { "src": "^/legal/terms/?$", "dest": "/brandweb/terms.html" },
    { "src": "^/legal/privacy/?$", "dest": "/brandweb/privacy.html" },
    { "src": "^/legal/cookies/?$", "dest": "/brandweb/cookies.html" },
    { "src": "^/legal/community-guidelines/?$", "dest": "/brandweb/community-guidelines.html" },
    { "src": "^/legal/booking-terms/?$", "dest": "/brandweb/booking-terms.html" },
    { "src": "^/legal/service-provider-agreement/?$", "dest": "/brandweb/service-provider-agreement.html" },
    { "src": "^/legal/privacy-choices/?$", "dest": "/brandweb/privacy-choices.html" },
    { "src": "^/share/([^/]+)$", "dest": "/api/share?id=$1" },
    {
      "src": "^/turnstile-native\\.html$",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/apple-app-site-association$",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=300, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/assetlinks\\.json$",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=300, must-revalidate"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "^/(auth|auth/callback|reset-password|reset-password-direct|reset-password-inline|reset-password-inline-healthaction|update-password|support|verify|turnstile-health|turnstile-health-resetaction)(?:/)?$",
      "dest": "/index.html"
    },
    { "src": "^/signup(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/join/[^/]+/?$", "dest": "/index.html" },
    { "src": "^/admin(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/assets/.*$", "status": 404 },
    { "src": "^/fonts/.*$", "status": 404 },
    { "src": "^/.*\\..*$", "status": 404 }
  ]
}
